# Lakeview environment template
#
# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored, so your real secrets are never committed.
#
# PowerShell:
#   Copy-Item .env.local.example .env.local
#   notepad .env.local
#
# Use the SAME names and values when you add environment variables in Vercel.

# --- Database (Neon) ---------------------------------------------------------
# Your Neon connection string. The non-pooled (direct) string is fine for both
# migrations and runtime at test volume. Switch to a pooled URL later if needed.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Clerk (use your own development instance) -------------------------------
# From the Clerk dashboard -> API Keys. Dev keys start with pk_test_ / sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Auth routing. These match the app's /sign-in and /sign-up pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# --- App ---------------------------------------------------------------------
# Required during onboarding. New users must enter this code once to verify.
# Pick any value for testing.
SIGNUP_INVITE_CODE="pick-any-code"

# Shared secret guarding the scheduled sync endpoint (/api/cron/sync).
# Use a long random string. In Vercel, set the same value.
CRON_SECRET="pick-a-long-random-string"

# --- Optional ----------------------------------------------------------------
# Extra calendar host domains allowed for iCal fetch (Airbnb is always allowed).
# Comma separated, no spaces. Example: vrbo.com,calendar.google.com
# LAKEVIEW_CALENDAR_HOST_ALLOWLIST="vrbo.com,calendar.google.com"
