{
  "name": "lakeview-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "e2e:clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});\"",
    "e2e:dev": "npm run e2e:clean && next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:clear-operational": "tsx scripts/clear-operational-data.ts",
    "db:clear-e2e-owner": "tsx scripts/clear-e2e-owner-jobs.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:setup": "playwright test --project=setup",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@prisma/client": "^6.19.3",
    "leaflet": "^1.9.4",
    "next": "^15.3.8",
    "node-ical": "^0.20.1",
    "prisma": "^6.19.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.6.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
